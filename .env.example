# Server-only account key. Never use a public environment variable prefix.
TELEGRAPH_API_KEY=
LENSY_SPONSOR_ENABLED=true
# Spending ceiling, not a fixed charge. Account routing needs a 0.26 temporary allowance.
LENSY_SPONSOR_MAX_CALL_USDC=0.30
LENSY_SPONSOR_DAILY_USDC=1
LENSY_SPONSOR_CHECKS_PER_USER=3
